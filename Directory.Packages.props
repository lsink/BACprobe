<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- BACnet protocol stack (MIT): https://github.com/ela-compil/BACnet -->
    <PackageVersion Include="BACnet" Version="4.0.0" />
    <!-- MVVM helpers for the WPF app (MIT) -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Excel (.xlsx) export (MIT) -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- Job files (SQLite, MIT; bundles the native SQLite library) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Serial ports for the passive MS/TP monitor (MIT) -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
</Project>
