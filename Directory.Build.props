<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Product>BACprobe</Product>
    <Authors>BACprobe contributors</Authors>
    <Copyright>Copyright (c) 2026 BACprobe contributors</Copyright>
    <!-- BACnet/IP needs UDP; keep analyzers on so platform-specific calls get flagged. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1416 is handled with OperatingSystem.IsWindows() guards; CA1515/CA1848 are noise for an app. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA2007;CA1031;CA1303;CA1305;CA1307;CA1310;CA1311;CA1304;CA1062</NoWarn>
  </PropertyGroup>
</Project>
