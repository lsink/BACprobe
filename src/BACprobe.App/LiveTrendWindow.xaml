<Window x:Class="BACprobe.App.LiveTrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="{Binding Title}" Icon="Assets/app.ico" Width="1000" Height="720" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="120" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- What is being sampled, how often, and what to do with it -->
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding IntervalSeconds}" ItemStringFormat="{}{0} s"
                  Width="80" AutomationProperties.Name="Sample interval"
                  ToolTip="How often BACprobe reads the point. Every read is a request to the controller: use a longer interval on a busy MS/TP trunk." />
        <Button Content="{Binding PauseLabel}" Padding="14,4" Margin="8,0,0,0" Command="{Binding PauseOrResumeCommand}" />
        <Button Content="Clear" Padding="14,4" Margin="8,0,0,0" Command="{Binding ClearCommand}"
                ToolTip="Throw away the samples so far and start the chart again." />
        <Button Content="Export..." Padding="14,4" Margin="8,0,0,0" Command="{Binding ExportCommand}"
                ToolTip="Save the samples as Excel or CSV. Closing this window discards them." />
      </StackPanel>
      <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" Opacity="0.9" Margin="0,0,12,0" />
    </DockPanel>

    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,10,0,6" />

    <Border Grid.Row="2" BorderThickness="1" BorderBrush="#33808080" CornerRadius="4">
      <app:TrendChart Points="{Binding Series}" Units="{Binding Units}" Margin="6"
                      AutomationProperties.Name="Live trend chart" />
    </Border>

    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" />

    <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time (this PC)" Binding="{Binding Time}" Width="180" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160" />
        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
  </Grid>
</Window>
