<Window x:Class="BACprobe.App.LessonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BACprobe lessons" Icon="Assets/app.ico" Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ListBox x:Name="LessonList" Grid.Column="0" DisplayMemberPath="Title" SelectionChanged="OnSelected"
             AutomationProperties.Name="Lessons" />

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SummaryText" Margin="0,6,0,14" Opacity="0.8" TextWrapping="Wrap" />
        <StackPanel x:Name="BodyPanel" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
