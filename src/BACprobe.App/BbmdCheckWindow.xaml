<Window x:Class="BACprobe.App.BbmdCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="{Binding Title}" Icon="Assets/app.ico" Width="960" Height="760" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.2*" MinHeight="110" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1*" MinHeight="90" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="Check again" Padding="14,4" Margin="12,0,0,0" VerticalAlignment="Top"
              Command="{Binding CheckCommand}" />
      <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" Opacity="0.9" />
    </DockPanel>

    <!-- What looks wrong, worst first; each with its likely cause and next step -->
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="#33808080" CornerRadius="4" Padding="8,4">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Findings}" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding BroadcastHeader}" FontWeight="SemiBold" Margin="0,12,0,4" />
    <DataGrid Grid.Row="3" ItemsSource="{Binding BroadcastTable}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="BBMD" Binding="{Binding Address}" Width="180" />
        <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="140" />
        <DataGridTextColumn Header="Distribution" Binding="{Binding Distribution}" Width="210" />
        <DataGridTextColumn Header="What its own table says" Binding="{Binding Note}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" Text="{Binding ForeignHeader}" FontWeight="SemiBold" Margin="0,12,0,4" />
    <DataGrid Grid.Row="5" ItemsSource="{Binding ForeignDevices}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="180" />
        <DataGridTextColumn Header="Registered for" Binding="{Binding Ttl}" Width="140" />
        <DataGridTextColumn Header="Time left" Binding="{Binding Remaining}" Width="140" />
        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="6" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
  </Grid>
</Window>
