<Window x:Class="BACprobe.App.WatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch list" Icon="Assets/app.ico" Width="1100" Height="640" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,10">
      <WrapPanel DockPanel.Dock="Right">
        <Button Content="Remove" Padding="14,4" Command="{Binding RemoveSelectedCommand}" ToolTip="Take the selected point off the watch list." />
        <Button Content="Clear all" Padding="14,4" Margin="6,0,0,0" Command="{Binding ClearCommand}" />
        <Button Content="Refresh" Padding="14,4" Margin="6,0,0,0" Command="{Binding RefreshCommand}"
                ToolTip="Read everything again and restart the live updates." />
      </WrapPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
    </DockPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="220" />
        <DataGridTextColumn Header="Object" Binding="{Binding ObjectId}" Width="90" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="140">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource FaultBrush}" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="90" />
      </DataGrid.Columns>
    </DataGrid>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding DeviceStatuses}" Margin="0,8,0,0" Opacity="0.8" />
  </Grid>
</Window>
