<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>BACprobe.App</RootNamespace>
    <!-- ThemeMode (Fluent) is experimental in .NET 9/10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="..\BACprobe.Core\BACprobe.Core.csproj" />
  </ItemGroup>
</Project>
