<!-- Colours that mean something (alarm, fault, override...), tuned to read on the Fluent light background.
     Dark.xaml has the same keys. Use them with DynamicResource so a theme switch repaints everything. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="FaultBrush" Color="#C42B1C" />
  <SolidColorBrush x:Key="AlarmBrush" Color="#B54A00" />
  <SolidColorBrush x:Key="OverrideBrush" Color="#8A5A00" />
  <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F" />
  <SolidColorBrush x:Key="InfoBrush" Color="#005FB8" />
  <SolidColorBrush x:Key="ChangedBrush" Color="#0067C0" />
  <SolidColorBrush x:Key="PanelBorderBrush" Color="#33000000" />
  <SolidColorBrush x:Key="PaneHeaderBrush" Color="#0A000000" />
  <SolidColorBrush x:Key="BannerBrush" Color="#B85C00" />
  <SolidColorBrush x:Key="BannerTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#1A107C10" />
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#26FF8C00" />
  <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#1AC42B1C" />
  <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#CCE4F7" />
  <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="#000000" />
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#CCE4F7" />
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#BBDAF2" />
  <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#A9D0EE" />
  <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="#000000" />
  <Thickness x:Key="ListBoxItemPadding">10,6</Thickness>
</ResourceDictionary>
