<Window x:Class="BACprobe.App.AlarmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alarms" Icon="Assets/app.ico" Width="1200" Height="800" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="160" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel>
      <Button DockPanel.Dock="Right" Content="Refresh" Padding="18,4" Margin="12,0,0,0" VerticalAlignment="Top"
              Command="{Binding RefreshCommand}" ToolTip="Ask every device again. The list is not updated live." />
      <StackPanel>
        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <WrapPanel Grid.Row="1" Margin="0,10,0,8">
      <CheckBox Content="Not acknowledged only" IsChecked="{Binding UnackedOnly}" VerticalAlignment="Center"
                ToolTip="Hide alarms someone has already acknowledged (they stay listed while the point is still in alarm)." />
    </WrapPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="OnRowDoubleClick"
              AutomationProperties.Name="Alarms">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Explanation}" />
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="160" />
        <DataGridTextColumn Header="Point" Binding="{Binding PointId}" Width="80" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="140">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="LifeSafety"><Setter Property="Foreground" Value="Red" /><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Fault"><Setter Property="Foreground" Value="IndianRed" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Alarm"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
        <DataGridTextColumn Header="Since (device clock)" Binding="{Binding Since}" Width="160" />
        <DataGridTextColumn Header="Not acknowledged" Binding="{Binding Unacked}" Width="150" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- The selected alarm: what it means, likely cause, next step; and the two things a tech can do with it -->
    <Border Grid.Row="3" BorderThickness="1" BorderBrush="#33808080" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Width="220">
          <Button Content="Acknowledge..." Padding="14,4" Command="{Binding AcknowledgeCommand}"
                  AutomationProperties.Name="Acknowledge alarm"
                  ToolTip="Tell the controller someone has seen this alarm. Asks you to confirm first; logged like a write. It fixes nothing." />
          <Button Content="Go to point" Padding="14,4" Margin="0,8,0,0" Command="{Binding GoToPointCommand}"
                  ToolTip="Select this point in the main window to see its properties and priority array (or double-click the row)." />
          <TextBlock Text="{Binding AckHint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0" FontSize="12" />
        </StackPanel>
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <TextBlock Grid.Row="4" Text="Could not check everything" FontWeight="SemiBold" Margin="0,12,0,4"
               Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
    <Border Grid.Row="5" BorderThickness="1" BorderBrush="#33808080" CornerRadius="4" Padding="8,4" MaxHeight="160"
            Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Findings}" />
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
