<Window x:Class="BACprobe.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Icon="Assets/app.ico" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding Headline}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />

    <!-- The details to check, as label / value rows -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Facts}" Margin="0,16,0,0" Grid.IsSharedSizeScope="True"
                  Visibility="{Binding FactsVisibility}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition SharedSizeGroup="FactLabel" Width="Auto" MaxWidth="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.65" Margin="0,0,16,0" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Grid.Row="2" Text="{Binding Body}" TextWrapping="Wrap" Opacity="0.85" Margin="0,16,0,0" />

    <Border Grid.Row="3" Margin="0,14,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
            BorderBrush="{DynamicResource FaultBrush}" Background="{DynamicResource DangerBackgroundBrush}" Visibility="{Binding WarningVisibility}">
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </Border>

    <!-- Expert actions: type the device number to unlock the button; and the device password, if it has one -->
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <StackPanel Visibility="{Binding TypeVisibility}">
        <TextBlock Text="{Binding TypePrompt}" TextWrapping="Wrap" />
        <TextBox x:Name="TypeBox" Margin="0,4,0,0" AutomationProperties.Name="Type to confirm" TextChanged="OnTypeChanged" />
      </StackPanel>
      <StackPanel Visibility="{Binding PasswordVisibility}" Margin="0,10,0,0">
        <TextBlock Text="Device password (leave empty if it has none)" />
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,0" AutomationProperties.Name="Device password" />
      </StackPanel>
    </StackPanel>

    <!-- Buttons are added in code: the caller says what each one does -->
    <StackPanel x:Name="ButtonPanel" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
  </Grid>
</Window>
