<Window x:Class="BACprobe.App.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a point" Icon="Assets/app.ico" Width="1000" Height="620" MinWidth="700" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <Button DockPanel.Dock="Right" Content="Read all devices" Padding="14,6" Margin="10,0,0,0"
              Command="{Binding ReadAllCommand}"
              ToolTip="Read every device's point list so the search covers the whole site. Devices you have already opened are included without this." />
      <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="8,6"
               AutomationProperties.Name="Search points"
               ToolTip="Every word must match the point's name, description, type, units, value or device name. Quote a phrase: &quot;supply fan&quot;. Add is:overridden for overridden points only." />
    </DockPanel>
    <TextBlock Grid.Row="1" Text="Examples:  zone temp    &quot;supply fan&quot;    damper is:overridden    ahu-1 pressure" Opacity="0.6" Margin="2,6,0,10" />

    <DataGrid Grid.Row="2" x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="OnResultDoubleClick" KeyDown="OnResultKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="190" />
        <DataGridTextColumn Header="Object" Binding="{Binding PointId}" Width="70" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110" />
        <DataGridTextColumn Header="Override" Binding="{Binding Override}" Width="150" />
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Go to point" Padding="14,6" Margin="10,0,0,0" Click="OnGoToClick"
              AutomationProperties.Name="Go to point" ToolTip="Select this point in the main window (or double-click a result)." />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
    </DockPanel>
  </Grid>
</Window>
