<Window x:Class="BACprobe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="BACprobe" Icon="Assets/app.ico" Height="860" Width="1240" MinHeight="760" MinWidth="1000">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenFindCommand}" />
  </Window.InputBindings>
  <Window.DataContext>
    <app:MainViewModel />
  </Window.DataContext>
  <!-- Scrolls instead of clipping when the screen is shorter than the layout needs -->
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Border Padding="20" MinHeight="820" Height="{Binding ActualHeight, ElementName=Scroller}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title and job bar -->
    <DockPanel Grid.Row="0">
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="Job name:" VerticalAlignment="Center" />
        <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="6,0,0,0"
                 AutomationProperties.Name="Job name"
                 ToolTip="A name for this site visit, e.g. City Hall. Saved in the job file and used as the EDE project name." />
        <TextBlock Text="Notes:" VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBox Text="{Binding JobNotes, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="6,0,0,0"
                 AutomationProperties.Name="Job notes"
                 ToolTip="Notes for yourself, e.g. which panel or floor. Saved in the job file." />
        <Button Content="Save job..." Padding="12,4" Margin="12,0,0,0" Command="{Binding SaveJobCommand}"
                ToolTip="Save the devices, points and write history to a .bacprobe file you can reopen later, even with no network." />
        <Button Content="Open job..." Padding="12,4" Margin="6,0,0,0" Command="{Binding OpenJobCommand}"
                ToolTip="Open a saved .bacprobe file and browse it offline." />
      </WrapPanel>
      <TextBlock Text="1. Choose your network adapter" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,8,0,8">
      <Button DockPanel.Dock="Right" Content="Re-check" Margin="8,0,0,0" Padding="12,4"
              Command="{Binding RunPreflightCommand}" />
      <Button DockPanel.Dock="Right" Content="Refresh list" Margin="8,0,0,0" Padding="12,4"
              Command="{Binding RefreshAdaptersCommand}" />
      <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display" />
    </DockPanel>

    <!-- Pre-flight: one line when all is well, full detail when the tech needs to read something -->
    <Expander Grid.Row="2" Header="{Binding PreflightSummary}" IsExpanded="{Binding PreflightExpanded, Mode=TwoWay}" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Preflight}" Margin="4,6,0,4">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type app:PreflightRow}">
            <StackPanel Margin="0,2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" Width="22" FontWeight="Bold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="SeaGreen" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Fail"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Check}" Width="140" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="{Binding Help}" Margin="162,2,0,0" Opacity="0.75" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasHelp}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <DockPanel Grid.Row="3">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <TextBlock Text="2. Find devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Text="Instance range:" VerticalAlignment="Center"
                   ToolTip="Optional. Leave both boxes empty to find every device, or enter a low and high device instance number." />
        <!-- Wide enough for a 7-digit instance plus the clear (x) button the Fluent theme adds -->
        <TextBox Text="{Binding LowText, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="8,0,4,0"
                 AutomationProperties.Name="Instance range from" />
        <TextBlock Text="to" VerticalAlignment="Center" />
        <TextBox Text="{Binding HighText, UpdateSourceTrigger=PropertyChanged}" Width="105" Margin="4,0,12,0"
                 AutomationProperties.Name="Instance range to" />
        <TextBlock Text="BBMD:" VerticalAlignment="Center" Margin="8,0,0,0"
                   ToolTip="Optional. Only for devices on other subnets. Ask the site contact for the BBMD's IP address." />
        <TextBox Text="{Binding BbmdText, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="8,0,4,0"
                 ToolTip="IP address, or IP:port, of the site's BBMD. Leave empty for the local subnet only." />
        <TextBlock Text="TTL (s):" VerticalAlignment="Center" />
        <TextBox Text="{Binding TtlText, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="4,0,12,0"
                 ToolTip="How long the BBMD keeps you registered. BACprobe renews automatically." />
        <Button Content="Scan" Padding="20,4" Command="{Binding ScanCommand}" />
        <Button Content="Find point..." Padding="12,4" Margin="12,0,0,0" Command="{Binding OpenFindCommand}"
                AutomationProperties.Name="Find point"
                ToolTip="Search every point on every device by name, description, type or value (Ctrl+F)." />
        <Button Content="Export device..." Padding="12,4" Margin="12,0,0,0" Command="{Binding ExportSelectedCommand}"
                ToolTip="Save the selected device point list as Excel, CSV or EDE." />
        <Button Content="Export all..." Padding="12,4" Margin="8,0,0,0" Command="{Binding ExportAllCommand}"
                ToolTip="Read every device found and save one combined point list." />
      </WrapPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding BbmdStatus}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />
      <!-- Network check: conflicts and differences from a saved job. One line unless something needs fixing. -->
      <Expander DockPanel.Dock="Top" Header="{Binding NetworkCheckSummary}" IsExpanded="{Binding NetworkCheckExpanded, Mode=TwoWay}"
                Margin="0,0,0,8" Visibility="{Binding HasNetworkCheck, Converter={StaticResource BoolToVis}}">
        <!-- Capped, with its own scrollbar, so a long list of findings can never push the device list off screen -->
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
        <StackPanel>
        <!-- Which devices are on which network -->
        <TextBlock Text="Network map" FontWeight="SemiBold" Margin="4,6,0,2" />
        <ItemsControl ItemsSource="{Binding NetworkMapLines}" Margin="4,0,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="18,1,0,1" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding NetworkFindings}" Margin="4,6,0,4">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type app:FindingRow}">
              <StackPanel Margin="0,4,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}" Width="22" FontWeight="Bold">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="SteelBlue" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
                          <DataTrigger Binding="{Binding Severity}" Value="Problem"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Margin="22,2,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Help}" Margin="22,2,0,0" Opacity="0.75" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
        </ScrollViewer>
      </Expander>
      <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6" BorderBrush="DarkOrange" BorderThickness="1" CornerRadius="4">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding OfflineBanner}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding OfflineBanner}" TextWrapping="Wrap" />
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" MinHeight="140" />
          <RowDefinition Height="Auto" />
          <!-- Tall enough for the properties grid plus the override panel; this is what keeps the properties visible -->
          <RowDefinition Height="3*" MinHeight="350" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" />
            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="160" />
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140" />
            <DataGridTextColumn Header="Firmware" Binding="{Binding Firmware}" />
          </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="2*" MinWidth="360" />
          </Grid.ColumnDefinitions>

          <!-- Objects. Points with a manual override (priority 8 or higher) show in orange and say which priority holds them. -->
          <DataGrid Grid.Column="0" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Object" Binding="{Binding Id}" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                        <Setter Property="Foreground" Value="DarkOrange" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RecentlyChanged}" Value="True">
                        <Setter Property="Foreground" Value="DeepSkyBlue" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                        <Setter Property="Foreground" Value="DarkOrange" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Override" Binding="{Binding Override}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="DarkOrange" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="ToolTip" Value="{Binding OverrideTooltip}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

          <!-- Actions (trend / override) on top so they are never cut off on a short screen; the properties list takes
               whatever space is left and scrolls by itself. -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding PropertiesHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid Grid.Row="2" ItemsSource="{Binding Properties}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Margin="0,0,0,10"
                        Visibility="{Binding IsTrendSelected, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Trend log" FontWeight="SemiBold" />
              <TextBlock Text="The controller records this point's history on its own. Open it to see a chart, the recorded values, and to save them to Excel."
                         TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0" />
              <Button Content="View trend..." Padding="16,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                      Command="{Binding ViewTrendCommand}" AutomationProperties.Name="View trend" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10"
                        Visibility="{Binding CanWriteSelected, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Override this point" FontWeight="SemiBold" />
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Value" Width="60" VerticalAlignment="Center" />
                <Grid>
                  <!-- On/off points and named multi-state points: a dropdown. Everything else: type a number. -->
                  <ComboBox ItemsSource="{Binding StateChoices}" SelectedItem="{Binding SelectedStateChoice}"
                            DisplayMemberPath="Label" AutomationProperties.Name="State to write"
                            Visibility="{Binding IsStateSelected, Converter={StaticResource BoolToVis}}" />
                  <TextBox Text="{Binding WriteValueText, UpdateSourceTrigger=PropertyChanged}"
                           AutomationProperties.Name="Value to write"
                           Visibility="{Binding IsNotStateSelected, Converter={StaticResource BoolToVis}}"
                           ToolTip="A number for analog points; 1, 2, 3... for multi-state points whose states have no names." />
                </Grid>
              </DockPanel>
              <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Priority" Width="60" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding SelectedPriority}"
                          DisplayMemberPath="Label" AutomationProperties.Name="Write priority" />
              </DockPanel>
              <TextBlock Text="{Binding SelectedPriority.Hint}" TextWrapping="Wrap" Opacity="0.75" Margin="60,4,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Write..." Padding="16,4" Command="{Binding WriteSelectedCommand}" />
                <Button Content="Release my override" Padding="16,4" Margin="8,0,0,0"
                        Command="{Binding ReleaseSelectedCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- Confirmation after an export or job save, with quick access to the file -->
    <StackPanel Grid.Row="4" Margin="0,12,0,0">
      <Border Margin="0,0,0,8" Padding="10,8" BorderBrush="SeaGreen" BorderThickness="1" CornerRadius="4" Background="#2230A050">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ResultMessage}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0" ToolTip="Dismiss"
                  Command="{Binding DismissResultCommand}" />
          <Button DockPanel.Dock="Right" Content="Show in folder" Padding="12,3" Margin="8,0,0,0"
                  Command="{Binding ShowResultInFolderCommand}" />
          <Button DockPanel.Dock="Right" Content="Open file" Padding="12,3" Margin="8,0,0,0"
                  Command="{Binding OpenResultFileCommand}" />
          <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding OverrideSummary}" Margin="16,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
        <!-- Live values: refresh the point list by itself -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding LiveStatus}" Opacity="0.75" VerticalAlignment="Center" Margin="0,0,10,0" />
          <CheckBox Content="COV" IsChecked="{Binding UseCov}" Margin="0,0,10,0" VerticalAlignment="Center"
                    AutomationProperties.Name="Use COV"
                    ToolTip="Ask the device to push changes to us (change-of-value). Points or devices that refuse are polled instead. Untick to poll everything." />
          <ComboBox ItemsSource="{Binding LiveIntervals}" SelectedItem="{Binding LiveIntervalSeconds}" ItemStringFormat="{}{0} s"
                    Width="70" Margin="0,0,6,0" AutomationProperties.Name="Live refresh interval"
                    ToolTip="How often to re-read points that are polled (all of them if COV is off)." />
          <ToggleButton Content="Live values" IsChecked="{Binding IsLive}" IsEnabled="{Binding CanUseLive}" Padding="12,4"
                        AutomationProperties.Name="Live values"
                        ToolTip="Keep the point list up to date, so you can watch values change and see overrides appear. Needs a live connection." />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </DockPanel>
    </StackPanel>
    <Expander Grid.Row="5" Header="Write log (also saved to %LOCALAPPDATA%\BACprobe\write-log.txt)" Margin="0,8,0,0">
      <ListBox ItemsSource="{Binding WriteLogLines}" Height="90" FontFamily="Consolas" />
    </Expander>
  </Grid>
  </Border>
  </ScrollViewer>
</Window>
