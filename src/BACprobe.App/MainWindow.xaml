<Window x:Class="BACprobe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="BACprobe" Height="800" Width="1200">
  <Window.DataContext>
    <app:MainViewModel />
  </Window.DataContext>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="1. Choose your network adapter" FontSize="16" FontWeight="SemiBold" />
    <DockPanel Grid.Row="1" Margin="0,8,0,12">
      <Button DockPanel.Dock="Right" Content="Re-check" Margin="8,0,0,0" Padding="12,4"
              Command="{Binding RunPreflightCommand}" />
      <Button DockPanel.Dock="Right" Content="Refresh list" Margin="8,0,0,0" Padding="12,4"
              Command="{Binding RefreshAdaptersCommand}" />
      <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Display" />
    </DockPanel>

    <ItemsControl Grid.Row="2" ItemsSource="{Binding Preflight}" Margin="0,0,0,12">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type app:PreflightRow}">
          <StackPanel Margin="0,2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Icon}" Width="22" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="SeaGreen" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
                      <DataTrigger Binding="{Binding Severity}" Value="Fail"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Check}" Width="140" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Help}" Margin="162,2,0,0" Opacity="0.75" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasHelp}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <DockPanel Grid.Row="3">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="2. Find devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Text="Instance range (optional):" VerticalAlignment="Center" />
        <TextBox Text="{Binding LowText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,4,0" />
        <TextBlock Text="to" VerticalAlignment="Center" />
        <TextBox Text="{Binding HighText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="4,0,12,0" />
        <Button Content="Scan" Padding="20,4" Command="{Binding ScanCommand}" />
      </StackPanel>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" MinHeight="80" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="3*" MinHeight="120" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" />
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Address" Binding="{Binding Address}" />
            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="160" />
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140" />
            <DataGridTextColumn Header="Firmware" Binding="{Binding Firmware}" />
          </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <DataGrid Grid.Column="0" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Object" Binding="{Binding Id}" />
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{Binding PropertiesHeader}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DataGrid ItemsSource="{Binding Properties}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </Grid>
    </DockPanel>

    <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
  </Grid>
</Window>
