<Window x:Class="BACprobe.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare devices" Icon="Assets/app.ico" Width="1200" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="150" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="110" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="A" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedA}" DisplayMemberPath="Label"
                AutomationProperties.Name="Device A" />
      <TextBlock Grid.Column="2" Text="B" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,8,0" />
      <ComboBox Grid.Column="3" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedB}" DisplayMemberPath="Label"
                AutomationProperties.Name="Device B" />
      <Button Grid.Column="4" Content="Compare" Padding="22,4" Margin="16,0,0,0" Command="{Binding CompareCommand}" />
    </Grid>

    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
      <CheckBox Content="Differences only" IsChecked="{Binding DifferencesOnly}" VerticalAlignment="Center"
                ToolTip="Hide the points that are the same on both devices." />
      <CheckBox Content="Set aside live inputs" IsChecked="{Binding IgnoreLiveInputs}" Margin="20,0,0,0" VerticalAlignment="Center"
                ToolTip="Temperatures and other inputs follow the real world, so two devices rarely agree on them. Ticked: do not count those as differences." />
    </WrapPanel>

    <StackPanel Grid.Row="2" Margin="0,8,0,8">
      <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0" />
    </StackPanel>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Object" Binding="{Binding Object}" Width="90" />
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" />
        <DataGridTextColumn Header="A" Binding="{Binding ValueA}" Width="170" />
        <DataGridTextColumn Header="B" Binding="{Binding ValueB}" Width="170" />
        <DataGridTextColumn Header="Result" Binding="{Binding KindText}" Width="170">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Different"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="OnlyInA"><Setter Property="Foreground" Value="SteelBlue" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="OnlyInB"><Setter Property="Foreground" Value="SteelBlue" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" Text="{Binding PropertyHeader}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
    <DataGrid Grid.Row="5" ItemsSource="{Binding PropertyRows}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Property" Binding="{Binding Property}" Width="200" />
        <DataGridTextColumn Header="A" Binding="{Binding ValueA}" Width="*" />
        <DataGridTextColumn Header="B" Binding="{Binding ValueB}" Width="*" />
        <DataGridTextColumn Header="Result" Binding="{Binding KindText}" Width="120">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Different"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
