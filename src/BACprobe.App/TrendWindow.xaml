<Window x:Class="BACprobe.App.TrendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        Title="{Binding Title}" Icon="Assets/app.ico" Width="1000" Height="760" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="200" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="140" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- What the log is, and what to show -->
    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Label"
                  Width="130" AutomationProperties.Name="How many records" IsEnabled="{Binding NotBusy}" />
        <Button Content="Refresh" Padding="14,4" Margin="8,0,0,0" Command="{Binding LoadCommand}" />
        <Button Content="Export..." Padding="14,4" Margin="8,0,0,0" Command="{Binding ExportCommand}"
                ToolTip="Save the records as Excel or CSV." />
        <Button Content="Cancel" Padding="14,4" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" Opacity="0.9" />
    </DockPanel>

    <TextBlock Grid.Row="1" Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,10,0,6" />

    <Border Grid.Row="2" BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" CornerRadius="4">
      <app:TrendChart Points="{Binding Series}" Units="{Binding Units}" Margin="6"
                      AutomationProperties.Name="Trend chart" />
    </Border>

    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" />

    <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time (device clock)" Binding="{Binding Time}" Width="180" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140" />
        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" />
  </Grid>
</Window>
