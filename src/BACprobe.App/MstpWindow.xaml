<Window x:Class="BACprobe.App.MstpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:BACprobe.App"
        xmlns:mstp="clr-namespace:BACprobe.Core.Mstp;assembly=BACprobe.Core"
        Title="MS/TP monitor" Icon="Assets/app.ico" Width="1440" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="170" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="140" />
    </Grid.RowDefinitions>

    <!-- Port, baud, start/stop -->
    <WrapPanel Grid.Row="0">
      <TextBlock Text="Port" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" Width="110" Margin="8,0,0,0"
                IsEnabled="{Binding IsIdle}" AutomationProperties.Name="COM port"
                ToolTip="The USB-RS485 adapter's COM port. Device Manager shows which one it is." />
      <Button Content="Refresh" Padding="10,4" Margin="6,0,0,0" Command="{Binding RefreshPortsCommand}" />
      <TextBlock Text="Baud" VerticalAlignment="Center" Margin="16,0,0,0" />
      <ComboBox ItemsSource="{Binding Bauds}" SelectedItem="{Binding SelectedBaud}" Width="150" Margin="8,0,0,0"
                IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Baud rate"
                ToolTip="Auto-detect listens a few seconds at each common rate. Field trunks are mostly 38400 or 76800." />
      <Button Content="Start" Padding="22,4" Margin="16,0,0,0" Command="{Binding StartCommand}" />
      <Button Content="Stop" Padding="22,4" Margin="6,0,0,0" Command="{Binding StopCommand}" />
      <Button Content="Open capture..." Padding="12,4" Margin="24,0,0,0" Command="{Binding OpenRecordingCommand}"
              ToolTip="Analyse a capture saved earlier (here or with bacprobe mstp-monitor --record). No adapter needed." />
      <Button Content="Save capture..." Padding="12,4" Margin="6,0,0,0" Command="{Binding SaveCaptureCommand}"
              ToolTip="Keep what was just heard, to compare later or send to someone." />
      <Button Content="Export for Wireshark..." Padding="12,4" Margin="6,0,0,0" Command="{Binding ExportPcapCommand}"
              ToolTip="Save the frames heard as a .pcap file you can open in Wireshark (link type BACnet MS/TP). Damaged frames are not included." />
      <Button Content="Demo" Padding="12,4" Margin="6,0,0,0" Command="{Binding LoadDemoCommand}"
              ToolTip="Show a made-up trunk with a dead node, a low Max Master and some noise, to see what the monitor reports." />
    </WrapPanel>

    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="#33FF8C00"
            Visibility="{Binding HasLatencyWarning, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding LatencyWarning}" TextWrapping="Wrap" />
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.85" />
    <TextBlock Grid.Row="3" Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,8" />

    <!-- Who is on the trunk, and what looks wrong -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.7*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Nodes (double-click one to see only its traffic)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DataGrid x:Name="NodeGrid" ItemsSource="{Binding Nodes}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="NodeGrid_DoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="60" />
            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80" />
            <DataGridTextColumn Header="Frames" Binding="{Binding FramesSent}" Width="80" />
            <DataGridTextColumn Header="Token in" Binding="{Binding TokensReceived}" Width="85" />
            <DataGridTextColumn Header="Missed" Binding="{Binding TokenNotTaken}" Width="80" />
            <DataGridTextColumn Header="Polls" Binding="{Binding PollsSent}" Width="70" />
            <DataGridTextColumn Header="Data" Binding="{Binding DataFrames}" Width="70" />
            <DataGridTextColumn Header="Bad turns" Binding="{Binding BadTurns}" Width="95" />
            <DataGridTextColumn Header="Token loop" Binding="{Binding AverageLoop}" Width="100" />
            <DataGridTextColumn Header="Pickup avg / max" Binding="{Binding Pickup}" Width="*" MinWidth="130" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="What looks wrong" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="4" Padding="8,4">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Findings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type app:FindingRow}">
                  <StackPanel Margin="0,4,0,6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Icon}" Width="22" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="SteelBlue" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="DarkOrange" /></DataTrigger>
                              <DataTrigger Binding="{Binding Severity}" Value="Problem"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Margin="22,2,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Help}" Margin="22,2,0,0" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>

    <!-- The live frame list -->
    <DockPanel Grid.Row="5" Margin="0,12,0,4">
      <TextBlock Text="Frames going by" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Text="MAC" VerticalAlignment="Center" Margin="20,0,0,0" />
      <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0"
               AutomationProperties.Name="Filter by MAC" ToolTip="Type a MAC address (0-255) to see only frames from or to it. Empty shows everything." />
      <Button Content="Clear" Padding="8,3" Margin="6,0,0,0" Command="{Binding ClearFilterCommand}" />
      <CheckBox Content="Hide token and polls" IsChecked="{Binding HideTokenAndPolls}" Margin="16,0,0,0" VerticalAlignment="Center"
                ToolTip="The token passing is most of the traffic. Hide it to see the real BACnet conversation." />
      <CheckBox Content="Pause" IsChecked="{Binding Paused}" Margin="16,0,0,0" VerticalAlignment="Center"
                ToolTip="Freeze the list so you can read it. Capture carries on underneath." />
    </DockPanel>
    <DataGrid Grid.Row="6" x:Name="LogGrid" ItemsSource="{Binding LogLines}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time (s)" Binding="{Binding Time}" Width="90" />
        <DataGridTextColumn Header="What happened" Binding="{Binding Text}" Width="*">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
